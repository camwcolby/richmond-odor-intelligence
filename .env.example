
APP_ENV=development
DATABASE_PATH=data/odor_demo.db
RICHMOND_LAT=37.9358
RICHMOND_LON=-122.3477
NOAA_STATION=9414863

# Sonoma Insight DMS
# NEVER put the real token in this example file.
SONOMA_DMS_TOKEN=
SONOMA_DMS_URL=https://insightdms.sonomatech.com/api/TimeSeriesData/filterAsTimeSeriesJson
SONOMA_NORTH_H2S_STREAM=9950
SONOMA_SOUTH_H2S_STREAM=9963
SONOMA_WIND_SPEED_STREAM=9986
SONOMA_WIND_DIRECTION_STREAM=9987
SONOMA_INTERVAL_SECONDS=300
SONOMA_LOOKBACK_HOURS=2

# Secure default:
SONOMA_SSL_VERIFY=true

# Preferred fix for a corporate TLS interception certificate:
# SONOMA_CA_BUNDLE=C:\path\to\your\corporate-ca-bundle.pem

# LOCAL DIAGNOSTIC ONLY, not for production:
# SONOMA_SSL_VERIFY=false

# Future integration slots:
SURVEY123_WEBHOOK_SECRET=
CMMS_API_URL=
CMMS_API_TOKEN=


# Open-Meteo atmospheric enrichment
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_SSL_VERIFY=true
# OPEN_METEO_CA_BUNDLE=C:\path\to\corporate-ca-bundle.pem

# ML pipeline
ML_AUTOMATION_ENABLED=true
ML_INGEST_MINUTES=15
ML_RETRAIN_HOURS=24
ML_DATABASE_PATH=data/ml_history.db
ML_MODEL_PATH=data/odor_model.joblib
ML_METRICS_PATH=data/odor_model_metrics.json
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive

# Live upstream cache
LIVE_CACHE_TTL_SECONDS=120
LIVE_CACHE_STALE_SECONDS=21600
LIVE_CACHE_DIR=data/live_cache
